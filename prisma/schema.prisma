// DropDeploy - Prisma schema (PRD-aligned)
// https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  CONTRIBUTOR
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  role              UserRole @default(USER)
  mustResetPassword Boolean  @default(false) @map("must_reset_password")

  projectQuota Int @default(5) @map("project_quota")
  // Custom domains the user may claim across all their projects.
  domainQuota  Int @default(1) @map("domain_quota")

  projects      Project[]
  auditLogs     AuditLog[]
  gitProviders  GitProvider[]
  projectAccess ProjectAccess[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String?     @db.Text
  source           SourceType
  githubUrl        String?     @map("github_url")
  type             ProjectType
  branch           String      @default("main")
  isPrivate        Boolean     @default(false) @map("is_private")
  useStaticHosting Boolean     @default(false) @map("use_static_hosting")

  // Auto-deploy on git push (GitHub webhooks). Disabled by default.
  autoDeploy       Boolean @default(false) @map("auto_deploy")
  githubHookId     String? @map("github_hook_id") // numeric hook id from GitHub, for deletion
  webhookSecretEnc String? @map("webhook_secret_enc") @db.Text // AES-256-GCM triplet (matches GitProvider)
  webhookSecretIv  String? @map("webhook_secret_iv")
  webhookSecretTag String? @map("webhook_secret_tag")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deployments          Deployment[]
  environmentVariables EnvironmentVariable[]
  auditLogs            AuditLog[]
  showcase             ProjectShowcase?
  proxyHits            ProxyHit[]
  accessList           ProjectAccess[]
  customDomains        CustomDomain[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("projects")
}

/// Lifecycle of a user-supplied custom domain.
///
///   PENDING_DNS  — created; ownership TXT not seen yet
///   VERIFYING    — a check is in flight
///   VERIFIED     — ownership proven; the edge is now allowed to issue a cert
///   PROVISIONING — routing live, waiting on the first ACME issuance
///   ACTIVE       — serving over HTTPS
///   FAILED       — verification or issuance failed; user can retry
enum DomainStatus {
  PENDING_DNS
  VERIFYING
  VERIFIED
  PROVISIONING
  ACTIVE
  FAILED
}

/// A custom hostname mapped onto a project.
///
/// `hostname` is globally unique — that uniqueness IS the claim lock and the
/// primary defence against one project hijacking another's domain. Combined
/// with the TXT ownership proof, only the DNS-proven owner keeps the claim.
model CustomDomain {
  id        String       @id @default(cuid())
  hostname  String       @unique // punycode, lowercase, no trailing dot
  projectId String       @map("project_id")
  status    DomainStatus @default(PENDING_DNS)

  /// Exactly one primary per project (enforced in the service, not the DB, so
  /// that swapping primaries stays a single transaction).
  isPrimary         Boolean @default(false) @map("is_primary")
  /// Non-primary domains 301 to the primary when true (canonicalisation/SEO).
  redirectToPrimary Boolean @default(true) @map("redirect_to_primary")

  /// TXT value published at _dropdeploy-verify.<hostname>.
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at")
  lastCheckedAt     DateTime? @map("last_checked_at")
  /// Human-readable reason for the most recent failure (shown in the UI).
  lastError         String?   @map("last_error") @db.Text
  /// Consecutive failed re-checks; drives back-off and eventual revocation.
  failureCount      Int       @default(0) @map("failure_count")
  /// Set once the edge has actually served TLS for this host.
  certIssuedAt      DateTime? @map("cert_issued_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("custom_domains")
}

enum AccessKind {
  USER
  DOMAIN
}

// Per-project access list for PRIVATE deployments.
// An entry is either a specific USER (by userId) or a whole email DOMAIN.
// The proxy authorizes a request if the viewer is the owner, matches a USER
// entry, or their email matches a DOMAIN entry.
model ProjectAccess {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  kind      AccessKind
  userId    String?    @map("user_id") // set when kind = USER
  domain    String? // set when kind = DOMAIN, e.g. "entri.me"
  createdAt DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, domain])
  @@index([projectId])
  @@map("project_access")
}

model ProjectShowcase {
  id               String    @id @default(cuid())
  projectId        String    @unique @map("project_id")
  shortDescription String    @map("short_description") @db.VarChar(140)
  tags             String[]
  liveUrl          String?   @map("live_url")
  repoUrl          String?   @map("repo_url")
  contactUrl       String?   @map("contact_url")
  isPublished      Boolean   @default(false) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  viewCount        Int       @default(0) @map("view_count")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@map("project_showcases")
}

enum ServingMethod {
  CONTAINER
  STATIC_FILES
}

model Deployment {
  id            String           @id @default(cuid())
  status        DeploymentStatus @default(QUEUED)
  containerPort Int?             @map("container_port")
  subdomain     String?          @unique
  buildStep     String?          @map("build_step")
  buildLog      String?          @map("build_log") @db.Text
  commitHash    String?          @map("commit_hash")
  servingMethod ServingMethod    @default(CONTAINER) @map("serving_method")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("deployments")
}

enum SourceType {
  GITHUB
  GITLAB
  UPLOAD
}

model GitProvider {
  id             String     @id @default(cuid())
  provider       SourceType
  providerUserId String     @map("provider_user_id")
  username       String
  avatarUrl      String?    @map("avatar_url")

  encryptedToken String @map("encrypted_token") @db.Text
  iv             String
  authTag        String @map("auth_tag")

  // GitLab only — refresh token and expiry (GitHub tokens don't expire)
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  refreshIv             String?   @map("refresh_iv")
  refreshAuthTag        String?   @map("refresh_auth_tag")
  tokenExpiresAt        DateTime? @map("token_expires_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One account per provider per user (intentional v1 constraint)
  @@unique([userId, provider])
  @@index([userId])
  @@map("git_providers")
}

enum ProjectType {
  STATIC
  NODEJS
  NEXTJS
  DJANGO
  REACT
  FASTAPI
  FLASK
  VUE
  SVELTE
  GO
  RUST
  JAVA
}

model EnvironmentVariable {
  id             String         @id @default(cuid())
  key            String
  encryptedValue String         @map("encrypted_value") @db.Text
  iv             String
  authTag        String         @map("auth_tag")
  environment    EnvEnvironment @default(ALL)

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, key, environment])
  @@index([projectId])
  @@map("environment_variables")
}

enum EnvEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  ALL
}

model AuditLog {
  id        String @id @default(cuid())
  action    String // ENV_CREATED, ENV_UPDATED, ENV_DELETED
  targetKey String @map("target_key")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([userId])
  @@map("audit_logs")
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYED
  FAILED
  CANCELLED
}

model ProxyHit {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  path      String   @default("/")
  referer   String?
  device    String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("proxy_hits")
}

model PlatformEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?  @map("user_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([createdAt])
  @@map("platform_events")
}
