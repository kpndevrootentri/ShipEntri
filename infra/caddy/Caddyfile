# DropDeploy edge — TLS termination only.
#
# This file terminates TLS and hands every request to the Next.js app with the
# original Host header intact. It deliberately does NOT route to containers:
# `src/proxy.ts` is the single authoritative router, and it is where the
# private-URL gate and the ProxyHit analytics live. An edge that proxied a
# tenant hostname straight to a container port would silently bypass both.
#
# Placeholders to substitute before use:
#   {$BASE_DOMAIN}          e.g. app.en3.wtf
#   {$APP_UPSTREAM}         e.g. 127.0.0.1:3001
#   {$INTERNAL_EDGE_TOKEN}  the shared secret from the app's env
#   {$ACME_EMAIL}           contact address for Let's Encrypt
#   {$DNS_API_TOKEN}        DNS provider token, for the wildcard cert only

{
	email {$ACME_EMAIL}

	# ── On-demand TLS ─────────────────────────────────────────────────────
	# Caddy calls `ask` during the TLS handshake for any hostname it has no
	# certificate for. A 200 authorises an ACME order; anything else fails
	# the handshake with no order placed.
	#
	# The token travels as a query parameter because Caddy's `ask` is a plain
	# GET with no header support; Caddy appends `domain=<host>` to whatever
	# query string is already there. Keep this URL on loopback so the token
	# never crosses a network.
	#
	# `interval`/`burst` are Caddy's own throttle on top of the app's: at most
	# 5 new names per 2 minutes. Both matter, because Let's Encrypt allows
	# only 50 certificates per registered domain per week and failed
	# validations are throttled harder.
	on_demand_tls {
		ask http://{$APP_UPSTREAM}/api/internal/tls-check?token={$INTERNAL_EDGE_TOKEN}
		interval 2m
		burst 5
	}

	# Uncomment for the first production run. Staging certificates are not
	# trusted by browsers, but its rate limits are far higher — validate the
	# whole flow here before spending real quota.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── Reusable upstream block ───────────────────────────────────────────────────
(app_upstream) {
	reverse_proxy {$APP_UPSTREAM} {
		# The router resolves the project from the Host header, so it must
		# arrive unmodified.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Deployed apps stream logs and may hold long-lived connections.
		flush_interval -1
	}

	encode zstd gzip

	# Baseline hardening for everything the platform serves. Note there is no
	# CSP here: the content is arbitrary tenant applications, and a platform-wide
	# CSP would break them. Tenants set their own.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ── Platform + tenant subdomains ──────────────────────────────────────────────
# One wildcard certificate, obtained over DNS-01 (the only challenge type that
# can issue a wildcard). Unchanged by the custom-domain work.
*.{$BASE_DOMAIN}, {$BASE_DOMAIN} {
	tls {
		dns {$DNS_PROVIDER} {$DNS_API_TOKEN}
	}
	import app_upstream
}

# ── Custom domains ────────────────────────────────────────────────────────────
# Catch-all for every other hostname. `on_demand` means no certificate is held
# in advance; one is ordered at handshake time, and only if the ask endpoint
# authorises it. Renewal is automatic — there is no cron to maintain.
:443 {
	tls {
		on_demand
	}
	import app_upstream
}

# Port 80 exists for the HTTP-01 challenge and to redirect humans. Caddy answers
# /.well-known/acme-challenge/* itself; `src/proxy.ts` leaves that path alone.
:80 {
	redir https://{host}{uri} permanent
}
